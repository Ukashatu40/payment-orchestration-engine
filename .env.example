# .env.example — copy to .env.local for local dev

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payflow
DB_POOL_MAX=20

# API authentication
# Comma-separated list of valid API keys
API_KEYS=dev-api-key-001,dev-api-key-002

# Gateway API keys/webhook secrets are NOT read from environment
# variables — they live in the gateway_config DB table (api_key,
# webhook_secret columns) and are seeded/updated via:
#   npx ts-node scripts/seed-gateway-secrets.ts --gateway=PAYSTACK --api-key=sk_test_xxx --webhook-secret=whsec_xxx
# See README.md "Configuring gateway sandbox credentials" for details.