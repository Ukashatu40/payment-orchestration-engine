# .env.example — copy to .env.local for local dev

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payflow
DB_POOL_MAX=20

# API authentication
# Comma-separated list of valid API keys
API_KEYS=dev-api-key-001,dev-api-key-002

# Gateway webhook secrets (mock values for development)
RAZORPAY_WEBHOOK_SECRET=mock-razorpay-secret
STRIPE_WEBHOOK_SECRET=mock-stripe-secret
PAYU_WEBHOOK_SECRET=mock-payu-secret
UPI_WEBHOOK_SECRET=mock-upi-secret