# .env.example — copy to .env.local for local dev

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payflow
DB_POOL_MAX=20
# Hosted Postgres (Neon/Supabase): set DATABASE_URL to the DIRECT connection
# string and DB_SSL=true; DATABASE_URL overrides the DB_HOST/... values above.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DB_SSL=true

# Auth — REQUIRED in production (>= 32 random chars; boot fails otherwise)
# JWT_SECRET=
# Seeds the SUPER_ADMIN on first migration. REQUIRED in production; locally
# it defaults to admin@payflow.local / ChangeMe123!
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# API authentication
# Comma-separated list of valid API keys
API_KEYS=dev-api-key-001,dev-api-key-002

# Gateway API keys/webhook secrets are NOT read from environment
# variables — they live in the gateway_config DB table (api_key,
# webhook_secret columns) and are seeded/updated via:
#   npx ts-node scripts/seed-gateway-secrets.ts --gateway=PAYSTACK --api-key=sk_test_xxx --webhook-secret=whsec_xxx
# See README.md "Configuring gateway sandbox credentials" for details.