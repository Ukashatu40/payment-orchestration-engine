{
  "name": "payflow-orchestration-layer",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:scenarios": "jest --selectProjects scenarios --runInBand",
    "test:all": "jest --runInBand --coverage",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:fresh": "docker-compose down -v && docker-compose up -d",
    "docker:logs": "docker-compose logs -f api",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^11.0.1",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.29",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "allowJs": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid|@nestjs/jwt)/)"
    ],
    "moduleNameMapper": {
      "^uuid$": "/Users/apple/codes/javascript/backend/payflow-orchestration-layer/node_modules/uuid/dist/index.js"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": ".coverage",
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(uuid|@nestjs/jwt)/)"
        ],
        "moduleNameMapper": {
          "^uuid$": "<rootDir>/node_modules/uuid/dist/index.js"
        },
        "moduleFileExtensions": [
          "ts",
          "json",
          "js"
        ]
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/test/integration/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(uuid|@nestjs/jwt)/)"
        ],
        "moduleNameMapper": {
          "^uuid$": "<rootDir>/node_modules/uuid/dist/index.js"
        },
        "globalSetup": "<rootDir>/test/integration/setup.ts",
        "globalTeardown": "<rootDir>/test/integration/teardown.ts"
      },
      {
        "displayName": "scenarios",
        "testMatch": [
          "<rootDir>/test/scenarios/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(uuid|@nestjs/jwt)/)"
        ],
        "moduleNameMapper": {
          "^uuid$": "<rootDir>/node_modules/uuid/dist/index.js"
        },
        "globalSetup": "<rootDir>/test/integration/setup.ts",
        "globalTeardown": "<rootDir>/test/integration/teardown.ts",
        "testTimeout": 30000
      }
    ]
  }
}
